{
  "name": "notes-webapp",
  "type": "web-application",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "notes-webapp",
  "entrypoint": "deployment/web-application",
  "exposure": "internet",
  "stories": [
    "F1.1",
    "F1.2",
    "F1.3",
    "F2.1",
    "F2.2",
    "F2.3",
    "F2.4",
    "F3.1",
    "F3.2",
    "F3.3",
    "F3.4"
  ],
  "description": "The single-page Team Notes app for signed-in members: notes list with pinned notes on top, a note reading view, a create-note form, and pin/unpin controls. Calls only notes-api. Does not hold any data or credentials.",
  "dependencies": [
    {
      "kind": "component",
      "name": "notes-api",
      "description": "Lists, reads, creates and pins notes.",
      "wiring": {
        "endpoint": {
          "component": "pf-notes-1821-notes-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "NOTES_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "description": "Signs members in through the platform identity provider.",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "pf-notes-1821-user-auth",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
