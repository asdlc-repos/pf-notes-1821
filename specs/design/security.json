{
  "version": 3,
  "permissions": [
    {
      "resource": "notes",
      "component": "notes-api",
      "description": "The team's shared notes",
      "actions": [
        { "handle": "read", "description": "List every note and read one" },
        { "handle": "create", "description": "Create a note" },
        { "handle": "pin", "description": "Pin or unpin any note" }
      ]
    }
  ],
  "groups": [
    { "name": "Team Members", "description": "People on the team who share notes" }
  ],
  "roles": [
    {
      "name": "Member",
      "description": "Reads, creates and pins the team's notes.",
      "stories": ["F1.1", "F1.2", "F1.3", "F2.1", "F2.2", "F2.3", "F2.4", "F3.1", "F3.2", "F3.3", "F3.4"],
      "grants": ["notes:read", "notes:create", "notes:pin"],
      "assignTo": ["Team Members"]
    }
  ],
  "testUsers": [
    { "username": "test-member", "roles": ["Member"] }
  ]
}
